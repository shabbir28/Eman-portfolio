<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="695.0" prefWidth="1050.0" styleClass="dashboard-root" stylesheets="/css/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AddItemController">

    <children>
        <!-- Page Heading positioned like Dashboard -->
        <Label text="Add Item" styleClass="dashboard-title" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0" />

        <!-- Scrollable area for the main content so smaller screens can scroll -->
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: white; -fx-background-color: white;"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="80.0" AnchorPane.bottomAnchor="0.0">
            <content>
                <StackPane alignment="CENTER" style="-fx-background-color: white;">
                    <children>
                        <VBox alignment="CENTER" spacing="60.0">
                            <children>
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="auctionButton" text="Auction" onAction="#handleAuction"
                                                prefWidth="260.0" prefHeight="140.0"
                                                style="-fx-background-radius: 32; -fx-background-color: linear-gradient(to bottom right, #14015c, #8a82c8); -fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: 700; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.12), 20, 0, 0, 8);" />

                                        <Button fx:id="userButton" text="User" onAction="#handleUser"
                                                prefWidth="260.0" prefHeight="140.0"
                                                style="-fx-background-radius: 32; -fx-background-color: linear-gradient(to bottom right, #14015c, #8a82c8); -fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: 700; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.12), 20, 0, 0, 8);" />

                                        <Button fx:id="storeButton" text="Store" onAction="#handleStore"
                                                prefWidth="260.0" prefHeight="140.0"
                                                style="-fx-background-radius: 32; -fx-background-color: linear-gradient(to bottom right, #14015c, #8a82c8); -fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: 700; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.12), 20, 0, 0, 8);" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
