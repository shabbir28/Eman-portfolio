<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="800.0" prefWidth="1400.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AuctionInventoryController">
    <children>
        <!-- Header -->
        <Label text="Auction Inventory" styleClass="dashboard-title" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1464;" />

        <!-- Toggle Buttons (Top Right) -->
        <HBox spacing="10" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
             <ToggleButton fx:id="btnTotal" text="Total" onAction="#handleTabSwitch" styleClass="tab-toggle-button" selected="true"/>
             <ToggleButton fx:id="btnReceived" text="Received" onAction="#handleTabSwitch" styleClass="tab-toggle-button"/>
             <ToggleButton fx:id="btnIssued" text="Issued" onAction="#handleTabSwitch" styleClass="tab-toggle-button"/>
        </HBox>

        <!-- Main Content Area -->
        <StackPane AnchorPane.topAnchor="90.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">
            
            <!-- Total View -->
            <VBox fx:id="viewTotal" spacing="15" styleClass="card-pane" visible="true">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Total Auction Inventory" style="-fx-font-size: 18px; -fx-text-fill: #1a1464; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchTotal" promptText="Search product, supplier, order" prefWidth="300" styleClass="search-field"/>
                    </HBox>
                    <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToHeight="true" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="table-container">
                        <content>
                            <TableView fx:id="tableTotal" style="-fx-font-size: 12px; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTotalItem" text="Item Name" minWidth="220" prefWidth="280"/>
                                        <TableColumn fx:id="colTotalRecQty" text="Received Quantity" minWidth="150" prefWidth="180" style="-fx-alignment: CENTER;" />
                                        <TableColumn fx:id="colTotalIssQty" text="Issued Quantity" minWidth="150" prefWidth="180" style="-fx-alignment: CENTER;" />
                                        <TableColumn fx:id="colTotalRemQty" text="Remaining Quantity" minWidth="150" prefWidth="180" style="-fx-alignment: CENTER;" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                        </content>
                    </ScrollPane>
                </children>
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>
            </VBox>

            <!-- Received View -->
            <VBox fx:id="viewReceived" spacing="15" styleClass="card-pane" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Received Inventory" style="-fx-font-size: 18px; -fx-text-fill: #1a1464; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchReceived" promptText="Search product, supplier, order" prefWidth="300" styleClass="search-field"/>
                    </HBox>
                    <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToHeight="true" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="table-container">
                        <content>
                            <TableView fx:id="tableReceived" style="-fx-font-size: 12px; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRecItem" text="Item Name" minWidth="220" prefWidth="280"/>
                                        <TableColumn fx:id="colRecQty" text="Quantity" minWidth="100" prefWidth="130" style="-fx-alignment: CENTER;" />
                                        <TableColumn fx:id="colRecLetterNo" text="Letter No./Reference" minWidth="160" prefWidth="200"/>
                                        <TableColumn fx:id="colRecDate" text="Received Date" minWidth="120" prefWidth="150"/>
                                        <TableColumn fx:id="colRecRemarks" text="Remarks" minWidth="180" prefWidth="240" style="-fx-alignment: CENTER_LEFT;"/>
                                        <TableColumn fx:id="colRecAction" text="Actions" minWidth="140" prefWidth="160" style="-fx-alignment: CENTER;" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                        </content>
                    </ScrollPane>
                </children>
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>
            </VBox>

            <!-- Issued View -->
            <VBox fx:id="viewIssued" spacing="15" styleClass="card-pane" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Issued Inventory" style="-fx-font-size: 18px; -fx-text-fill: #1a1464; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchIssued" promptText="Search product, supplier, order" prefWidth="300" styleClass="search-field"/>
                    </HBox>
                    <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToHeight="true" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="table-container">
                        <content>
                            <TableView fx:id="tableIssued" style="-fx-font-size: 12px; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colIssItem" text="Item Name" minWidth="220" prefWidth="280"/>
                                        <TableColumn fx:id="colIssQty" text="Issued Quantity" minWidth="140" prefWidth="170" style="-fx-alignment: CENTER;" />
                                        <TableColumn fx:id="colIssDate" text="Issued Date" minWidth="120" prefWidth="150"/>
                                        <TableColumn fx:id="colIssRemarks" text="Remarks" minWidth="180" prefWidth="240" style="-fx-alignment: CENTER_LEFT;"/>
                                        <TableColumn fx:id="colIssAction" text="Actions" minWidth="140" prefWidth="160" style="-fx-alignment: CENTER;" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                        </content>
                    </ScrollPane>
                </children>
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>
            </VBox>

        </StackPane>
    </children>
</AnchorPane>
