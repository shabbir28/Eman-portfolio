<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<AnchorPane prefHeight="800.0" prefWidth="1400.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.UserInventoryController">
    <children>
        <!-- Header -->
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1464;" styleClass="dashboard-title" text="User Inventory" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" />

        <!-- Toggle Buttons (Top Right) -->
        <HBox spacing="10" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
             <ToggleButton fx:id="btnTotal" onAction="#handleTabSwitch" selected="true" styleClass="tab-toggle-button" text="Total" />
             <ToggleButton fx:id="btnIssued" onAction="#handleTabSwitch" styleClass="tab-toggle-button" text="Issued" />
             <ToggleButton fx:id="btnPending" onAction="#handleTabSwitch" styleClass="tab-toggle-button" text="Pending" />
        </HBox>

        <!-- Main Content Area -->
        <StackPane AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="90.0">
            
            <!-- Total View -->
            <VBox fx:id="viewTotal" spacing="15" styleClass="card-pane" visible="true">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1a1464; -fx-font-weight: bold;" text="Total User Inventory" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchTotal" prefWidth="300" promptText="Search product, supplier, order" styleClass="search-field" />
                    </HBox>
                    <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToHeight="true" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="table-container">
                        <content>
                            <TableView fx:id="tableTotal" style="-fx-font-size: 12px; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTotalItem" minWidth="180" prefWidth="200" text="Item Name" style="-fx-alignment: CENTER_LEFT;" />
                                        <TableColumn fx:id="colTotalQty" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" text="Quantity" />
                                        <TableColumn fx:id="colTotalRecDate" minWidth="120" prefWidth="140" text="Received Date" />
                                        <TableColumn fx:id="colTotalPO" minWidth="150" prefWidth="180" text="Purchase Order No." />
                                        <TableColumn fx:id="colTotalVendor" minWidth="150" prefWidth="180" text="Vendor Name" />
                                        <TableColumn fx:id="colTotalDHAID" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" text="DHA ID" />
                                        <TableColumn fx:id="colTotalName" minWidth="120" prefWidth="150" text="Employee Name" />
                                        <TableColumn fx:id="colTotalBranch" minWidth="120" prefWidth="150" text="Branch Name" />
                                        <TableColumn fx:id="colTotalWDem" minWidth="150" prefWidth="170" text="Warranty Demand" />
                                        <TableColumn fx:id="colTotalWProv" minWidth="150" prefWidth="170" text="Warranty Provided" />
                                        <TableColumn fx:id="colTotalIssuedDate" minWidth="120" prefWidth="140" text="Issued Date" />
                                        <TableColumn fx:id="colTotalReason" minWidth="150" prefWidth="200" text="Pending Reason" style="-fx-alignment: CENTER_LEFT;" />
                                        <TableColumn fx:id="colTotalStatus" minWidth="100" prefWidth="130" style="-fx-alignment: CENTER;" text="Status" />
                                        <TableColumn fx:id="colTotalRemarks" minWidth="150" prefWidth="200" text="Remarks" style="-fx-alignment: CENTER_LEFT;" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                        </content>
                    </ScrollPane>
                </children>
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
            </VBox>

            <!-- Issued View -->
            <VBox fx:id="viewIssued" spacing="15" styleClass="card-pane" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1a1464; -fx-font-weight: bold;" text="Issued Inventory" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchIssued" prefWidth="300" promptText="Search product, supplier, order" styleClass="search-field" />
                    </HBox>
                    <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToHeight="true" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="table-container">
                        <content>
                            <TableView fx:id="tableIssued" style="-fx-font-size: 12px; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colIssuedItem" minWidth="180" prefWidth="200" text="Item Name" style="-fx-alignment: CENTER_LEFT;" />
                                    <TableColumn fx:id="colIssuedQty" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" text="Quantity" />
                                    <TableColumn fx:id="colIssuedRecDate" minWidth="120" prefWidth="140" text="Received Date" />
                                    <TableColumn fx:id="colIssuedPO" minWidth="150" prefWidth="180" text="Purchase Order No." />
                                    <TableColumn fx:id="colIssuedVendor" minWidth="150" prefWidth="180" text="Vendor Name" />
                                    <TableColumn fx:id="colIssuedDHAID" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" text="DHA ID" />
                                    <TableColumn fx:id="colIssuedName" minWidth="120" prefWidth="150" text="Employee Name" />
                                    <TableColumn fx:id="colIssuedBranch" minWidth="120" prefWidth="150" text="Branch Name" />
                                    <TableColumn fx:id="colIssuedWDem" minWidth="150" prefWidth="170" text="Warranty Demand" />
                                    <TableColumn fx:id="colIssuedWProv" minWidth="150" prefWidth="170" text="Warranty Provided" />
                                    <TableColumn fx:id="colIssuedDate" minWidth="120" prefWidth="140" text="Issued Date" />
                                    <TableColumn fx:id="colIssuedRemarks" minWidth="150" prefWidth="200" text="Remarks" style="-fx-alignment: CENTER_LEFT;" />
                                    <TableColumn fx:id="colIssuedAction" minWidth="150" prefWidth="150" style="-fx-alignment: CENTER;" text="Actions" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </content>
                    </ScrollPane>
                </children>
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
            </VBox>

            <!-- Pending View -->
            <VBox fx:id="viewPending" spacing="15" styleClass="card-pane" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #1a1464; -fx-font-weight: bold;" text="Pending Inventory" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchPending" prefWidth="300" promptText="Search product, supplier, order" styleClass="search-field" />
                    </HBox>
                    <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToHeight="true" fitToWidth="false" VBox.vgrow="ALWAYS" styleClass="table-container">
                        <content>
                            <TableView fx:id="tablePending" style="-fx-font-size: 12px; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colPendingItem" minWidth="180" prefWidth="200" text="Item Name" style="-fx-alignment: CENTER_LEFT;" />
                                        <TableColumn fx:id="colPendingQty" minWidth="90" prefWidth="100" style="-fx-alignment: CENTER;" text="Quantity" />
                                        <TableColumn fx:id="colPendingRecDate" minWidth="120" prefWidth="140" text="Received Date" />
                                        <TableColumn fx:id="colPendingPO" minWidth="150" prefWidth="180" text="Purchase Order No." />
                                        <TableColumn fx:id="colPendingVendor" minWidth="150" prefWidth="180" text="Vendor Name" />
                                        <TableColumn fx:id="colPendingDHAID" minWidth="100" prefWidth="110" style="-fx-alignment: CENTER;" text="DHA ID" />
                                        <TableColumn fx:id="colPendingName" minWidth="120" prefWidth="150" text="Employee Name" />
                                        <TableColumn fx:id="colPendingBranch" minWidth="120" prefWidth="150" text="Branch Name" />
                                        <TableColumn fx:id="colPendingWDem" minWidth="150" prefWidth="170" text="Warranty Demand" />
                                        <TableColumn fx:id="colPendingWProv" minWidth="150" prefWidth="170" text="Warranty Provided" />
                                        <TableColumn fx:id="colPendingReason" minWidth="150" prefWidth="200" text="Pending Reason" style="-fx-alignment: CENTER_LEFT;" />
                                        <TableColumn fx:id="colPendingRemarks" minWidth="150" prefWidth="200" text="Remarks" style="-fx-alignment: CENTER_LEFT;" />
                                        <TableColumn fx:id="colPendingAction" minWidth="150" prefWidth="150" style="-fx-alignment: CENTER;" text="Actions" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                        </content>
                    </ScrollPane>
                </children>
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
            </VBox>

        </StackPane>
    </children>
</AnchorPane>
