<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<StackPane
        xmlns="http://javafx.com/javafx/21.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        stylesheets="/css/global.css"
        fx:controller="gui.LoginController"
        prefHeight="400.0"
        prefWidth="600.0"
        styleClass="container"
>
    <!-- Background image as an ImageView so it reliably shows behind content -->
    <children>
        <ImageView fx:id="bgImageView" fitWidth="600.0" fitHeight="400.0" preserveRatio="false" pickOnBounds="true" />

        <VBox
                alignment="CENTER"
                spacing="10"
                style="-fx-background-color: transparent;"
        >
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label
                    text="Store Inventory Management System"
                    style="-fx-font-size: 30px; -fx-text-fill: white; -fx-font-family: Arial;"
            />


            <TextField
                    fx:id="usernameField"
                    promptText="Username"
                    maxWidth="250"/>

            <PasswordField
                    fx:id="passwordField"
                    promptText="Password"
                    maxWidth="250"/>

            <Label
                    fx:id="errorLabel"
                    style="-fx-text-fill: red;"/>

            <Button
                    text="Login"
                    onAction="#handleLogin"
                    defaultButton="true"
                    styleClass="dialog"
            />
        </VBox>
    </children>
</StackPane>
