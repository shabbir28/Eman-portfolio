<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="695.0" prefWidth="1050.0" styleClass="dashboard-root" stylesheets="/css/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AddUserItemController">

    <children>
        <!-- Page Heading -->
        <Label text="Add Item" styleClass="dashboard-title" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="20.0" />

        <!-- Scrollable form container -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    style="-fx-background: white; -fx-background-color: white;"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="80.0" AnchorPane.bottomAnchor="0.0">
            <content>
                <!-- Form Container -->
                <VBox alignment="CENTER" spacing="20.0" prefWidth="1050.0" style="-fx-background-color: white;">
                    <children>
                        <!-- Form Panel with border -->
                        <VBox styleClass="low-stock-card" spacing="25.0" alignment="CENTER" maxWidth="800.0" prefWidth="800.0">
                            <padding>
                                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
                            </padding>
                            <children>
                                <!-- Form Title -->
                                <Label text="Add User Item" styleClass="card-title" />

                                <!-- Header Fields -->
                                <GridPane hgap="20.0" vgap="20.0" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150.0" prefWidth="150.0" />
                                        <ColumnConstraints minWidth="300.0" prefWidth="300.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Source Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #14015c; -fx-font-weight: 600;" />
                                        <HBox spacing="15.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <RadioButton fx:id="rbDhaId" text="DHA ID" selected="true" />
                                                <RadioButton fx:id="rbBranch" text="Branch" />
                                            </children>
                                        </HBox>

                                        <Label fx:id="sourceLabel" text="DHA ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #14015c; -fx-font-weight: 600;" />
                                        <StackPane alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <TextField fx:id="dhaIdField" promptText="Enter DHA ID" prefWidth="300.0" />
                                                <ComboBox fx:id="branchComboBox" promptText="Select Branch" prefWidth="300.0" visible="false" />
                                            </children>
                                        </StackPane>

                                        <Label text="PO No.:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #14015c; -fx-font-weight: 600;" />
                                        <TextField fx:id="poNoField" promptText="Select purchase order #" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300.0" />

                                        <Label text="Vendor:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #14015c; -fx-font-weight: 600;" />
                                        <TextField fx:id="vendorField" promptText="Enter vendor detail" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300.0" />

                                        <Label text="Receiving Date:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-text-fill: #14015c; -fx-font-weight: 600;" />
                                        <DatePicker fx:id="receiveDatePicker" promptText="Enter receiving date" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300.0" />

                                        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-text-fill: #14015c; -fx-font-weight: 600;" />
                                        <ComboBox fx:id="statusComboBox" promptText="Select Status" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="300.0" />
                                    </children>
                                </GridPane>

                                <!-- Items Section -->
                                <VBox spacing="10.0" alignment="CENTER_LEFT" prefWidth="800.0">
                                    <Label text="Items" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #14015c;" />
                                    
                                    <TableView fx:id="itemsTable" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colItemName" text="Item Name" prefWidth="150.0" />
                                            <TableColumn fx:id="colQuantity" text="Qty" prefWidth="50.0" />
                                            <TableColumn fx:id="colWarrantyDemand" text="W. Demand" prefWidth="100.0" />
                                            <TableColumn fx:id="colWarrantyProvided" text="W. Provided" prefWidth="100.0" />
                                            <TableColumn fx:id="colRemarks" text="Remarks" prefWidth="150.0" />
                                            <TableColumn fx:id="colAction" text="Action" prefWidth="80.0" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>

                                    <Button text="+ Add Item" onAction="#handleAddItem"
                                            style="-fx-background-color: transparent; -fx-text-fill: #14015c; -fx-font-weight: bold; -fx-border-color: #14015c; -fx-border-style: dashed; -fx-border-radius: 5; -fx-cursor: hand;"
                                            prefWidth="800.0"/>
                                </VBox>

                                <!-- Action Buttons -->
                                <HBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <Button fx:id="saveButton" text="Save" onAction="#handleSave"
                                                style="-fx-background-color: #14015c; -fx-text-fill: white; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 10 30; -fx-font-size: 14px;" />
                                        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
                                                style="-fx-background-color: white; -fx-text-fill: #14015c; -fx-font-weight: 600; -fx-background-radius: 8; -fx-border-color: #14015c; -fx-border-radius: 8; -fx-border-width: 2; -fx-padding: 10 30; -fx-font-size: 14px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

